

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ─── Users & Settings ─────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings     Settings?
  resumes      ResumeVersion[]
  applications Application[]
}

model Settings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  autoApply            Boolean  @default(false)
  autoFollowup         Boolean  @default(false)
  maxDailyApplications Int      @default(20)
  followupDelayDays    Int      @default(7)
  minFitScore          Float    @default(0.60)

  targetRoles     String[] @default(["React Developer", "Frontend Developer", "Full Stack Developer", "Junior AI Developer"])
  excludeKeywords String[] @default([])

  linkedinEnabled Boolean @default(true)
  indeedEnabled   Boolean @default(true)
  atsEnabled      Boolean @default(true)
  emailEnabled    Boolean @default(true)
  wellfoundEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Jobs ─────────────────────────────────────────────────────────────────────

model Job {
  id         String  @id @default(cuid())
  externalId String?
  title      String
  company    String
  location   String?
  remote     Boolean @default(false)

  description    String
  url            String  @unique
  source         String
  applyUrl       String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?

  postedAt  DateTime?
  scrapedAt DateTime  @default(now())

  fitScore      Float?
  confidence    String?
  shouldApply   Boolean?
  reasons       String[]
  requiredSkills String[]
  missingSkills  String[]
  roleType       String?
  seniorityLevel String?

  status JobStatus @default(FOUND)

  embedding   JobEmbedding?
  application Application?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([company])
  @@index([scrapedAt])
}

enum JobStatus {
  FOUND
  QUEUED
  SCORED
  READY
  APPLYING
  APPLIED
  SKIPPED
  FAILED
}

model JobEmbedding {
  id        String                      @id @default(cuid())
  jobId     String                      @unique
  job       Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  createdAt DateTime                    @default(now())
}

// ─── Resume Versions ──────────────────────────────────────────────────────────

model ResumeVersion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  type    String
  content Json
  pdfPath String?

  applicationCount Int @default(0)
  interviewCount   Int @default(0)
  offerCount       Int @default(0)

  isActive Boolean @default(true)
  version  Int     @default(1)

  embedding    ResumeEmbedding?
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

model ResumeEmbedding {
  id              String                      @id @default(cuid())
  resumeVersionId String                      @unique
  resumeVersion   ResumeVersion               @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  embedding       Unsupported("vector(1536)")
  createdAt       DateTime                    @default(now())
}

// ─── Applications ─────────────────────────────────────────────────────────────

model Application {
  id              String  @id @default(cuid())
  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId           String  @unique
  job             Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id])

  status    ApplicationStatus @default(PENDING)
  platform  String?
  appliedAt DateTime?

  coverLetter   String?
  customAnswers Json?

  viewedAt        DateTime?
  assessmentAt    DateTime?
  interviewAt     DateTime?
  rejectedAt      DateTime?
  offerAt         DateTime?
  rejectionReason String?
  offerDetails    Json?

  followups         Followup[]
  recruiterMessages RecruiterMessage[]
  interviews        Interview[]
  embedding         ApplicationEmbedding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([appliedAt])
}

enum ApplicationStatus {
  PENDING
  APPLYING
  APPLIED
  VIEWED
  ASSESSMENT
  INTERVIEW
  GHOSTED
  REJECTED
  OFFER
  WITHDRAWN
}

model ApplicationEmbedding {
  id            String                      @id @default(cuid())
  applicationId String                      @unique
  application   Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  embedding     Unsupported("vector(1536)")
  createdAt     DateTime                    @default(now())
}

// ─── Follow-ups ───────────────────────────────────────────────────────────────

model Followup {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  sentAt      DateTime?
  status      FollowupStatus @default(PENDING)
  content     String?
  response    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledAt, status])
}

enum FollowupStatus {
  PENDING
  APPROVED
  SENT
  RESPONDED
  SKIPPED
}

model RecruiterMessage {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  direction String
  content   String
  channel   String

  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  type        String
  status      String   @default("scheduled")
  notes       String?
  feedback    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Agent Infrastructure ─────────────────────────────────────────────────────

model AgentLog {
  id        String   @id @default(cuid())
  sessionId String?
  level     String
  type      String
  tool      String?
  message   String
  data      Json?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([type, createdAt])
  @@index([level, createdAt])
}

model WorkflowState {
  id         String @id @default(cuid())
  workflowId String @unique
  type       String
  status     String

  currentStep String?
  data        Json?
  error       String?

  startedAt   DateTime  @default(now())
  pausedAt    DateTime?
  resumedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
}

model CaptchaQueue {
  id         String @id @default(cuid())
  workflowId String
  url        String
  platform   String
  screenshot String?
  status     String @default("pending")

  resolvedAt DateTime?
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Notification {
  id      String  @id @default(cuid())
  type    String
  title   String
  message String
  data    Json?
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([read, createdAt])
}
